{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": ".NET Core Debug Configuration (netcoredbg)",
  "type": "object",
  "properties": {
    "adapter": {
      "type": "string",
      "enum": ["netcoredbg"],
      "description": "Debug adapter name"
    },
    "label": {
      "type": "string",
      "description": "Label of the debug configuration"
    },
    "request": {
      "type": "string",
      "enum": ["launch", "attach"],
      "description": "Request type"
    },
    "program": {
      "type": "string",
      "description": "Path to the .NET DLL to debug"
    },
    "args": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Command line arguments",
      "default": []
    },
    "cwd": {
      "type": "string",
      "description": "Working directory"
    },
    "env": {
      "type": "object",
      "description": "Environment variables",
      "additionalProperties": { "type": "string" }
    },
    "stopAtEntry": {
      "type": "boolean",
      "description": "Stop at entry point",
      "default": false
    },
    "processId": {
      "type": ["string", "number"],
      "description": "Process ID to attach to (for attach requests)"
    }
  },
  "required": ["adapter", "label", "request"],
  "oneOf": [
    {
      "properties": { "request": { "const": "launch" } },
      "required": ["program"]
    },
    {
      "properties": { "request": { "const": "attach" } },
      "required": ["processId"]
    }
  ]
}
